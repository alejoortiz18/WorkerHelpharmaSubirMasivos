@{
    Layout = "_Layout";
    ViewData["Title"] = GestionArchivosEscaneados.Constants.EtiquetasUi.Transacciones;
}
@model GestionArchivosEscaneados.Models.ViewModels.TransaccionesUsuariosViewModel

<div class="page-header mb-4">
    <h1 class="h3 mb-1">@GestionArchivosEscaneados.Constants.EtiquetasUi.UsuariosEscaneo</h1>
    <p class="text-muted mb-0">Seleccione un usuario para ver sus fechas de escaneo.</p>
</div>

@if (Model.Usuarios.Count == 0)
{
    <div class="alert alert-info">@GestionArchivosEscaneados.Constants.EtiquetasUi.SinUsuarios</div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table id="tx-usuarios-table" class="table table-hover mb-0 align-middle tx-fechas-table w-auto">
                <thead class="table-light">
                    <tr>
                        <th scope="col">
                            <button type="button" class="tx-sort-btn" data-sort-key="usuario" aria-sort="none">
                                <span class="tx-sort-icons" aria-hidden="true">
                                    <span class="tx-sort-up">▲</span>
                                    <span class="tx-sort-down">▼</span>
                                </span>
                                <span class="tx-sort-label">@GestionArchivosEscaneados.Constants.EtiquetasUi.Usuario</span>
                            </button>
                        </th>
                        <th scope="col">
                            <button type="button" class="tx-sort-btn" data-sort-key="dias" aria-sort="none">
                                <span class="tx-sort-icons" aria-hidden="true">
                                    <span class="tx-sort-up">▲</span>
                                    <span class="tx-sort-down">▼</span>
                                </span>
                                <span class="tx-sort-label">@GestionArchivosEscaneados.Constants.EtiquetasUi.DiasEscaneados</span>
                            </button>
                        </th>
                        <th scope="col">
                            <button type="button" class="tx-sort-btn" data-sort-key="ultimo-dia" aria-sort="none">
                                <span class="tx-sort-icons" aria-hidden="true">
                                    <span class="tx-sort-up">▲</span>
                                    <span class="tx-sort-down">▼</span>
                                </span>
                                <span class="tx-sort-label">@GestionArchivosEscaneados.Constants.EtiquetasUi.UltimoDiaEscaneado</span>
                            </button>
                        </th>
                        <th class="tx-fechas-action-col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Usuarios)
                    {
                        <tr role="button"
                            data-usuario="@item.NombreUsuario"
                            data-dias="@item.CantidadDiasEscaneados"
                            data-ultimo-dia="@item.UltimoDiaEscaneado"
                            onclick="window.location='@Url.Action("Fechas", new { usuario = item.NombreUsuario })'">
                            <td>@item.NombreUsuario</td>
                            <td>@item.CantidadDiasEscaneados</td>
                            <td>@item.UltimoDiaEscaneado</td>
                            <td class="text-muted tx-fechas-action-col">&rarr;</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/transacciones-usuarios-sort.js" asp-append-version="true"></script>
}
