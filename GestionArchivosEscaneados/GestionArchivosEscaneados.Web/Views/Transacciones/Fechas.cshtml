@{
    Layout = "_Layout";
    ViewData["Title"] = GestionArchivosEscaneados.Constants.EtiquetasUi.FechasEscaneo;
}
@model GestionArchivosEscaneados.Models.ViewModels.TransaccionesFechasViewModel

<div class="mb-3">
    <a asp-action="Index" class="btn btn-link ps-0">@GestionArchivosEscaneados.Constants.EtiquetasUi.VolverUsuarios</a>
</div>

<div class="page-header mb-4">
    <h1 class="h3 mb-1">@GestionArchivosEscaneados.Constants.EtiquetasUi.FechasEscaneo</h1>
    <p class="text-muted mb-0">Usuario: <strong>@Model.Usuario</strong></p>
</div>

@if (Model.Fechas.Count == 0)
{
    <div class="alert alert-info">@GestionArchivosEscaneados.Constants.EtiquetasUi.SinFechas</div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle tx-fechas-table w-auto">
                <thead class="table-light">
                    <tr>
                        <th>@GestionArchivosEscaneados.Constants.EtiquetasUi.Fecha</th>
                        <th>@GestionArchivosEscaneados.Constants.EtiquetasUi.TotalEscaneo</th>
                        <th class="tx-fechas-action-col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Fechas)
                    {
                        <tr role="button" onclick="window.location='@Url.Action("Documentos", new { usuario = Model.Usuario, fecha = item.Fecha })'">
                            <td>@item.Fecha</td>
                            <td>@item.TotalEscaneo</td>
                            <td class="text-muted tx-fechas-action-col">&rarr;</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
